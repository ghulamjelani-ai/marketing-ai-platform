APP_NAME=Marketing AI Backend
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODELS=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_MODELS=
OPENAI_IMAGE_QUALITY=high
# Speech to text for the voice button (best first; the next is tried if one fails)
OPENAI_TRANSCRIBE_MODELS=gpt-4o-mini-transcribe,whisper-1

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=marketing_ai_db
DB_USER=marketing_ai_user
DB_PASSWORD=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_TOKEN_KEY=

# ---------------------------------------------------------------------------
# App mode: development | test | production
#   production: the backend refuses to start if the email settings are missing.
#   development: it only prints a warning.
APP_ENV=development

# Email (SMTP) for the 6-digit sign-in codes. Pick ONE of the setups below.
#
# A) Local sandbox inbox (development; nothing reaches a real inbox)
#    Start it:  backend\venv\Scripts\python backend\tools\dev_mailbox.py
#    Inbox:     http://localhost:8025   (Mailpit on the same ports works too)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@marketing-ai.local
SMTP_FROM_NAME=Marketing AI
SMTP_USE_TLS=false
SMTP_USE_SSL=false
#
# B) Gmail (needs 2-Step Verification and a 16-character App Password,
#    NEVER the normal Gmail password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your.sender@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM_EMAIL=your.sender@gmail.com
# SMTP_FROM_NAME=Marketing AI
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# C) A transactional provider (example: Brevo; SendGrid, Mailgun, Amazon SES are similar)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM_EMAIL=no-reply@yourdomain.com
# SMTP_FROM_NAME=Marketing AI
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
#
# Port 465 instead of 587: SMTP_USE_SSL=true and SMTP_USE_TLS=false.
# Seconds to wait for the mail server (each try; one retry on temporary errors):
SMTP_TIMEOUT=10

# ---------------------------------------------------------------------------
# Post notifications and the background check
# Emails to the account address when a post is published, scheduled, goes live or is edited.
POST_NOTIFICATIONS=true
# Marks due scheduled posts as live (and emails the owner) even when the site is closed.
# It runs inside the single backend process; POLL_SECONDS is at least 60.
BACKGROUND_POLLER=true
POLL_SECONDS=300
